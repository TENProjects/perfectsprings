{
  "name": "perfect-springs",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-check.mjs",
    "build:vps": "node scripts/build.mjs --public && node scripts/package-vps.mjs",
    "test:theme": "node tests/theme-browser.mjs",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
